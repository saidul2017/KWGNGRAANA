# Copy file ini menjadi .env.local lalu sesuaikan nilainya

# Secret untuk enkripsi cookie session (minimal 32 karakter)
SESSION_PASSWORD=ganti_dengan_minimal_32_karakter_random_yang_aman_xx

# Lokasi file SQLite (default: ./data/kwgn.db)
DATABASE_PATH=./data/kwgn.db

# Akun dosen default (dipakai saat seed)
DEFAULT_LECTURER_EMAIL=dosen@kwgn.id
DEFAULT_LECTURER_NAME=Dosen Kewarganegaraan
DEFAULT_LECTURER_PASSWORD=kwgn2026

# Opsional: API key untuk chatbot LLM (kosongkan untuk pakai mode rule-based)
OPENAI_API_KEY=
