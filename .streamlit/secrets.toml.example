# Salin ke .streamlit/secrets.toml lokal, atau isi via UI Streamlit Cloud:
# https://docs.streamlit.io/streamlit-community-cloud/get-started/deploy-an-app/connect-to-data-sources/secrets-management

# WAJIB: password awal dosen pertama kali (saat seed). Ganti dengan password kuat.
DEFAULT_LECTURER_PASSWORD = "ganti_password_kuat_minimal_8_karakter"

# OPSIONAL: kalau kosong, chatbot dan AI grading esai akan pakai mode rule-based
# fallback (tetap jalan, kualitas lebih rendah). Dapatkan key gratis di:
# https://aistudio.google.com/apikey
GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-2.5-flash"

# OPSIONAL: kalau dibiarkan kosong, DB SQLite akan disimpan di ./data/kwgn.db
# (cukup untuk demo Streamlit Cloud).
DATABASE_PATH = "./data/kwgn.db"
