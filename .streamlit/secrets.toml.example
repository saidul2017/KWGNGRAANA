# Salin file ini menjadi .streamlit/secrets.toml lalu isi
# (file secrets.toml ter-gitignore)

# Lokasi file SQLite — relatif terhadap project root
DATABASE_PATH = "./data/kwgn.db"

# Akun dosen default (dipakai saat seed pertama)
DEFAULT_LECTURER_EMAIL = "dosen@kwgn.id"
DEFAULT_LECTURER_NAME = "Dosen Kewarganegaraan"
DEFAULT_LECTURER_PASSWORD = "ganti_password_kuat_disini"

# === Gemini AI (opsional — bila kosong, chatbot rule-based, esai dinilai 0) ===
# Dapatkan di: https://aistudio.google.com/apikey
GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-2.5-flash"
GEMINI_TIMEOUT_SEC = 30
